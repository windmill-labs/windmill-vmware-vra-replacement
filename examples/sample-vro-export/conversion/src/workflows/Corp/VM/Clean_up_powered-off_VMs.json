          "to": "vms"
        }
      ],
      "script": "actionResult = System.getModule(\"com.corp.vm\").getPoweredOffVms(prefix,minDaysOff);"
    },
    {
      "name": "item2",
      "type": "custom-condition",
      "display_name": "Anything to delete?",
      "next": "item3",
