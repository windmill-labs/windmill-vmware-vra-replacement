    {
      "name": "item4",
      "type": "task",
      "display_name": "Delete approved VMs",
      "next": "item0",
      "alt_next": "",
      "on_error": "",
      "linked_workflow_id": "",
      "action": "",
      "in": [
        {
          "name": "vms",
          "type": "Array/VC:VirtualMachine",
          "from": "vms"
        },
        {
          "name": "approved",
          "type": "boolean",
