        },
        {
          "name": "approver",
          "type": "string",
          "from": "approver"
        }
      ],
      "out": [
        {
          "name": "deleted",
          "type": "Array/string",
          "to": "deleted"
        }
      ],
      "script": "deleted = [];\nif (!approved) {\n  System.warn(\"Deletion rejected by \" + approver);\n} else {\n  for (var i in vms) {\n    deleted.push(System.getModule(\"com.corp.vm\").deleteVm(vms[i]));\n  }\n}"
    }
